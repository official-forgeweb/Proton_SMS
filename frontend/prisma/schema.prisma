// Prisma Schema for Proton SMS
// Migrated from MongoDB/Mongoose schemas

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────

enum UserRole {
  admin
  coordinator
  teacher
  student
}

enum AttendanceStatus {
  present
  absent
  late
}

// ──────────────────────────────────────────────
// User
// ──────────────────────────────────────────────

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  password_hash         String
  role                  UserRole
  is_active             Boolean   @default(true)
  is_verified           Boolean   @default(true)
  last_login            DateTime?
  failed_login_attempts Int       @default(0)
  locked_until          DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  // Relations
  student              Student?
  teacher              Teacher?
  coordinator          Coordinator?
  enquiries_assigned   Enquiry[]        @relation("AssignedTo")
  enquiry_remarks      EnquiryRemark[]
  attendance_marked    Attendance[]
  fee_payments_received FeePayment[]
  fee_audit_logs       FeeAuditLog[]
  installment_date_histories InstallmentDateHistory[]
  queries_created    StudentQuery[]   @relation("QueryCreatedBy")
  queries_resolved   StudentQuery[]   @relation("QueryResolvedBy")
  query_replies        QueryReply[]
  query_internal_notes QueryInternalNote[]
  query_audit_logs     QueryAuditLog[]
  study_materials_uploaded StudyMaterial[] @relation("UploaderMaterial")
  notifications_received Notification[] @relation("NotificationRecipient")
  notifications_sent     Notification[] @relation("NotificationSender")
  messages_sent          Message[]      @relation("SentMessages")
  messages_received      Message[]      @relation("ReceivedMessages")
  tests_created            Test[]
  homework_created         Homework[]
  google_sheet_sync_logs   GoogleSheetSyncLog[]

  @@map("users")
}

// ──────────────────────────────────────────────
// Student
// ──────────────────────────────────────────────

model Student {
  id                String   @id @default(uuid())
  user_id           String   @unique
  PRO_ID            String   @unique
  first_name        String?
  last_name         String?
  date_of_birth     String?
  gender            String?
  email             String?
  phone             String?
  school_name       String?
  enrollment_date   String?
  enrollment_number String?
  admission_type    String?
  academic_status   String   @default("active")
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  // Relations
  user                    User                     @relation(fields: [user_id], references: [id])
  class_enrollments       StudentClassEnrollment[]
  subject_enrollments     StudentSubjectEnrollment[]
  attendance_records      Attendance[]
  test_results            TestResult[]
  homework_submissions    HomeworkSubmission[]
  fee_assignments         StudentFeeAssignment[]
  fee_payments            FeePayment[]
  queries                 StudentQuery[]
  remarks                 StudentRemark[]

  @@index([academic_status])
  @@index([phone])
  @@map("students")
}

// ──────────────────────────────────────────────
// Teacher
// ──────────────────────────────────────────────

model Teacher {
  id                String   @id @default(uuid())
  user_id           String   @unique
  employee_id       String?
  first_name        String?
  last_name         String?
  email             String?
  phone             String?
  qualification     String?
  specialization    String?
  experience_years  Int?
  date_of_joining   String?
  role_type         String?
  subjects          String[] @default([])
  employment_status String   @default("active")
  gender            String?
  permissions       String[] @default(["classes", "students", "enquiries", "tests", "homework", "demos", "attendance"])
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  // Relations
  user              User              @relation(fields: [user_id], references: [id])
  primary_classes   Class[]           @relation("PrimaryTeacher")
  class_schedules   ClassSchedule[]
  timetable_entries Timetable[]       @relation("TimetableTeacher")
  demo_classes      DemoClass[]
  queries_targeted  StudentQuery[]    @relation("QueryTargetTeacher")
  remarks           StudentRemark[]
  activity_logs     TeacherActivityLog[]

  @@index([employment_status])
  @@map("teachers")
}

// ──────────────────────────────────────────────
// Class (Batch)
// ──────────────────────────────────────────────

model Class {
  id                     String   @id @default(uuid())
  class_code             String   @unique
  class_name             String?
  grade_level            String?
  academic_year          String?
  batch_type             String?
  start_date             String?
  end_date               String?
  max_students           Int?
  current_students_count Int      @default(0)
  room_number            String?
  status                 String   @default("ongoing")
  course_fee             Float?
  course_duration_months Int?     @default(12)  // Duration in months (e.g. 12, 18, 24)

  // Legacy fields for backward compatibility
  subject                String?
  primary_teacher_id     String?
  class_days             String[] @default([])
  class_time_start       String?
  class_time_end         String?

  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  // Relations
  primary_teacher      Teacher?                @relation("PrimaryTeacher", fields: [primary_teacher_id], references: [id])
  schedule             ClassSchedule[]
  timetable_entries    Timetable[]
  student_enrollments  StudentClassEnrollment[]
  subject_enrollments  StudentSubjectEnrollment[]
  attendance_records   Attendance[]
  tests                Test[]
  homework             Homework[]
  fee_structures       FeeStructure[]
  demo_classes         DemoClass[]
  video_lectures       VideoLecture[]
  study_materials      StudyMaterial[]
  class_subjects       ClassSubject[]

  @@index([status])
  @@index([primary_teacher_id])
  @@map("classes")
}

// ──────────────────────────────────────────────
// Timetable (Date-specific class sessions)
// ──────────────────────────────────────────────

model Timetable {
  id          String   @id @default(uuid())
  class_id    String
  subject_id  String
  teacher_id  String?
  date        String                // e.g. "2026-04-08"
  start_time  String                // e.g. "17:00"
  end_time    String?               // e.g. "18:00"
  room        String?
  online_link String?
  notes       String?
  status      String   @default("scheduled")  // scheduled | completed | cancelled
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // Relations
  class_ref   Class    @relation(fields: [class_id], references: [id], onDelete: Cascade)
  teacher     Teacher? @relation("TimetableTeacher", fields: [teacher_id], references: [id])
  subject     Subject  @relation(fields: [subject_id], references: [id], onDelete: Cascade)
  attendance  Attendance[]

  @@index([class_id, date])
  @@index([teacher_id, date])
  @@index([date])
  @@map("timetable")
}

model ClassSchedule {
  id         String  @id @default(uuid())
  class_id   String
  subject_id String?
  teacher_id String?
  time_start String?
  time_end   String?
  days       String[] @default([])

  // Relations
  class_ref Class    @relation(fields: [class_id], references: [id], onDelete: Cascade)
  teacher   Teacher? @relation(fields: [teacher_id], references: [id])
  subject   Subject? @relation(fields: [subject_id], references: [id], onDelete: Cascade)

  @@index([class_id])
  @@map("class_schedules")
}

model StudentClassEnrollment {
  id                           String   @id @default(uuid())
  student_id                   String
  class_id                     String
  enrollment_date              String?
  enrollment_status            String   @default("active")
  overall_attendance_percentage Float    @default(0)
  average_marks                Float    @default(0)
  rank_in_class                Int?

  // Relations
  student Student @relation(fields: [student_id], references: [id])
  class   Class   @relation(fields: [class_id], references: [id])

  @@index([class_id, enrollment_status])
  @@index([student_id, enrollment_status])
  @@map("student_class_enrollments")
}

model StudentSubjectEnrollment {
  id              String   @id @default(uuid())
  student_id      String
  class_id        String
  subject_id      String
  enrollment_date String?
  status          String   @default("active")
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  // Relations
  student Student @relation(fields: [student_id], references: [id])
  class   Class   @relation(fields: [class_id], references: [id])
  subject Subject @relation(fields: [subject_id], references: [id], onDelete: Cascade)

  @@unique([student_id, class_id, subject_id])
  @@index([class_id, subject_id])
  @@index([student_id])
  @@map("student_subject_enrollments")
}

// ──────────────────────────────────────────────
// Enquiry
// ──────────────────────────────────────────────

model Enquiry {
  id                   String   @id @default(uuid())
  enquiry_number       String   @unique
  student_name         String?
  email                String?
  phone                String?
  parent_name          String?
  parent_phone         String?
  parent_email         String?
  relationship         String?
  current_class        String?
  school_name          String?
  interested_course    String?
  source               String?
  status               String   @default("new")
  priority             String   @default("medium")
  assigned_to          String?
  followup_count       Int      @default(0)
  converted_to_student Boolean  @default(false)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  // Relations
  assigned_user User?           @relation("AssignedTo", fields: [assigned_to], references: [id])
  remarks       EnquiryRemark[]
  demo_classes  DemoClass[]

  @@index([status])
  @@index([assigned_to])
  @@index([phone])
  @@map("enquiries")
}

model EnquiryRemark {
  id          String   @id @default(uuid())
  enquiry_id  String
  remark      String?
  remark_type String?
  created_by  String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // Relations
  enquiry Enquiry @relation(fields: [enquiry_id], references: [id])
  user    User?   @relation(fields: [created_by], references: [id])

  @@index([enquiry_id])
  @@map("enquiry_remarks")
}

model DemoClass {
  id          String   @id @default(uuid())
  demo_number String?
  enquiry_id  String
  demo_date   String?
  demo_time   String?
  subject_id  String?
  topic       String?
  class_id    String?
  teacher_id  String?
  status      String   @default("scheduled")
  demo_count  Int      @default(1)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // Relations
  enquiry Enquiry  @relation(fields: [enquiry_id], references: [id])
  class   Class?   @relation(fields: [class_id], references: [id])
  teacher Teacher? @relation(fields: [teacher_id], references: [id])
  subject Subject? @relation(fields: [subject_id], references: [id], onDelete: SetNull)

  @@index([enquiry_id])
  @@index([teacher_id])
  @@index([status])
  @@index([class_id])
  @@map("demo_classes")
}

// ──────────────────────────────────────────────
// Tests & Attendance
// ──────────────────────────────────────────────

model Attendance {
  id              String           @id @default(uuid())
  student_id      String
  class_id        String
  timetable_id    String?          // Link to specific session
  subject_id      String?          // Explicit subject
  attendance_date String
  status          AttendanceStatus
  marked_by       String?
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt

  // Relations
  student   Student    @relation(fields: [student_id], references: [id])
  class     Class      @relation(fields: [class_id], references: [id])
  timetable Timetable? @relation(fields: [timetable_id], references: [id])
  user      User?      @relation(fields: [marked_by], references: [id])
  subject   Subject?   @relation(fields: [subject_id], references: [id], onDelete: SetNull)

  @@index([student_id, attendance_date])
  @@index([class_id, attendance_date])
  @@index([timetable_id])
  @@map("attendance")
}

model Test {
  id                String   @id @default(uuid())
  test_code         String   @unique
  test_name         String?
  class_id          String
  subject_id        String?
  test_type         String?
  test_date         String?
  start_time        String?
  duration_minutes  Int?
  total_marks       Float?
  passing_marks     Float?
  description       String?
  images            String[] @default([])
  status            String   @default("scheduled")
  results_published Boolean  @default(false)
  students_appeared Int      @default(0)
  created_by        String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  // Relations
  class     Class        @relation(fields: [class_id], references: [id])
  creator   User?        @relation(fields: [created_by], references: [id])
  subject   Subject?     @relation(fields: [subject_id], references: [id], onDelete: SetNull)
  results   TestResult[]

  @@index([class_id])
  @@index([status])
  @@map("tests")
}

model TestResult {
  id              String   @id @default(uuid())
  test_id         String
  student_id      String
  marks_obtained  Float?
  total_marks     Float?
  percentage      Float?
  grade           String?
  pass_fail       String?
  rank_in_class   Int?
  was_present     Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  // Relations
  test    Test    @relation(fields: [test_id], references: [id])
  student Student @relation(fields: [student_id], references: [id])

  @@index([test_id])
  @@index([student_id])
  @@map("test_results")
}

// ──────────────────────────────────────────────
// Homework
// ──────────────────────────────────────────────

model Homework {
  id            String   @id @default(uuid())
  homework_code String?
  title         String?
  description   String?
  class_id      String
  subject_id    String?
  assigned_date String?
  due_date      String?
  total_marks   Float?
  attachments   String[] @default([])
  status        String   @default("active")
  created_by    String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Relations
  class       Class                @relation(fields: [class_id], references: [id])
  creator     User?                @relation(fields: [created_by], references: [id])
  subject     Subject?             @relation(fields: [subject_id], references: [id], onDelete: SetNull)
  submissions HomeworkSubmission[]

  @@index([class_id])
  @@map("homework")
}

model HomeworkSubmission {
  id              String   @id @default(uuid())
  homework_id     String
  student_id      String
  submission_date String?
  status          String   @default("pending")
  marks_obtained  Float?
  feedback        String?
  attachments     String[] @default([])
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  // Relations
  homework Homework @relation(fields: [homework_id], references: [id])
  student  Student  @relation(fields: [student_id], references: [id])

  @@index([homework_id])
  @@index([student_id])
  @@map("homework_submissions")
}

// ──────────────────────────────────────────────
// Fees
// ──────────────────────────────────────────────

model FeeStructure {
  id                String   @id @default(uuid())
  structure_name    String?
  class_id          String?
  academic_year     String?
  tuition_fee       Float?   @default(0)
  registration_fee  Float?   @default(0)
  admission_fee     Float?   @default(0)
  total_annual_fee  Float?
  max_installments  Int?     @default(12)       // Max allowed installments (1-12)
  is_active         Boolean  @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  // Relations
  class       Class?                 @relation(fields: [class_id], references: [id])
  assignments StudentFeeAssignment[]

  @@index([class_id])
  @@map("fee_structures")
}

model StudentFeeAssignment {
  id                    String   @id @default(uuid())
  student_id            String
  fee_structure_id      String?
  academic_year         String?
  total_fee             Float?               // Base fee
  admission_fee         Float?   @default(0)
  registration_fee      Float?   @default(0)
  discount_percentage   Float?   @default(0)
  discount_amount       Float?   @default(0)
  scholarship_amount    Float?   @default(0)
  final_fee             Float?               // Net Payable = (total + admission + registration) - discount - scholarship
  total_paid            Float    @default(0)
  total_pending         Float?
  payment_status        String   @default("pending")  // pending, partial, paid, overdue — auto-computed
  risk_level            String   @default("normal")   // normal, watchlist, high_risk_defaulter
  payment_mode          String   @default("one_time") // one_time | installment
  installment_strategy  String   @default("auto_equal") // auto_equal | manual_custom
  installment_count     Int?     @default(1)          // Number of installments (1-12)
  course_duration_months Int?    @default(12)          // Duration in months for interval calc
  preferred_due_day     Int?     @default(1)           // Day of month (1-28, clamped)
  start_date            String?                        // First installment date YYYY-MM-DD
  notes                 String?
  assigned_date         String?
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  // Relations
  student       Student          @relation(fields: [student_id], references: [id])
  fee_structure FeeStructure?    @relation(fields: [fee_structure_id], references: [id])
  installments  FeeInstallment[]
  audit_logs    FeeAuditLog[]

  @@index([student_id])
  @@index([payment_status])
  @@map("student_fee_assignments")
}

model FeeInstallment {
  id                  String    @id @default(uuid())
  assignment_id       String
  installment_number  Int                    // Stable: 1, 2, 3 ... up to 12. Never reshuffles.
  amount              Float                  // Amount due for this installment
  remaining_amount    Float     @default(0)  // Remaining after partial payment
  due_date            String                 // YYYY-MM-DD (UTC-safe string)
  paid_amount         Float     @default(0)
  paid_date           String?                // When it was actually paid
  status              String    @default("upcoming") // upcoming, due, paid, overdue, partially_paid
  payment_id          String?                // Links to FeePayment when fully paid
  date_change_count   Int       @default(0)
  is_deleted          Boolean   @default(false)
  deleted_at          DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  // Relations
  assignment     StudentFeeAssignment     @relation(fields: [assignment_id], references: [id], onDelete: Cascade)
  payment        FeePayment?              @relation(fields: [payment_id], references: [id])
  date_histories InstallmentDateHistory[]

  @@unique([assignment_id, installment_number])
  @@index([assignment_id])
  @@index([status])
  @@index([due_date])
  @@map("fee_installments")
}

model FeePayment {
  id                   String    @id @default(uuid())
  payment_number       String    @unique
  student_id           String
  amount_paid          Float?
  payment_date         String?
  payment_method       String?              // cash, online, bank_transfer, cheque
  transaction_id       String?
  payment_status       String    @default("completed")
  installment_number   Int?
  receipt_number       String?
  receipt_generated_at DateTime?
  received_by          String?
  remarks              String?
  is_deleted           Boolean   @default(false)
  deleted_at           DateTime?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  // Relations
  student      Student          @relation(fields: [student_id], references: [id])
  receiver     User?            @relation(fields: [received_by], references: [id])
  installments FeeInstallment[]

  @@index([student_id])
  @@index([payment_status])
  @@map("fee_payments")
}

model FeeAuditLog {
  id              String   @id @default(uuid())
  assignment_id   String
  user_id         String
  action          String            // installment_created, installment_edited, payment_recorded, recalculated, fee_assigned, fee_edited
  field_changed   String?           // e.g. "due_date", "amount", "installment_count"
  old_value       String?
  new_value       String?
  details         String?  @db.Text // JSON or human-readable details
  created_at      DateTime @default(now())

  assignment StudentFeeAssignment @relation(fields: [assignment_id], references: [id], onDelete: Cascade)
  user       User                 @relation(fields: [user_id], references: [id])

  @@index([assignment_id])
  @@index([user_id])
  @@map("fee_audit_logs")
}

model InstallmentDateHistory {
  id                    String   @id @default(uuid())
  installment_id        String
  previous_due_date     String
  new_due_date          String
  changed_by            String
  change_reason         String?
  created_at            DateTime @default(now())

  installment FeeInstallment @relation(fields: [installment_id], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [changed_by], references: [id])

  @@index([installment_id])
  @@index([changed_by])
  @@map("installment_date_histories")
}

// ──────────────────────────────────────────────
// Student Queries (Support / Requests)
// ──────────────────────────────────────────────

model StudentQuery {
  id              String   @id @default(uuid())
  query_number    String   @unique
  student_id      String
  query_type      String                // phone_change_student, whatsapp_student, old_assignment, personal_session, leave_application, other
  query_subtype   String?               // e.g. assignment name, teacher name, etc.
  description     String?               // Free text details
  target_teacher_id String?             // For personal_session
  status          String   @default("new")   // new, processing, resolved, unresolved
  priority        String   @default("medium") // low, medium, high
  raised_by       String                // "teacher" or "student"
  created_by_user_id String?            // User who created the query
  resolved_by_user_id String?           // User who resolved/updated the query
  resolved_at     DateTime?
  resolution_note String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  // Relations
  student         Student   @relation(fields: [student_id], references: [id])
  target_teacher  Teacher?  @relation("QueryTargetTeacher", fields: [target_teacher_id], references: [id])
  created_by_user User?     @relation("QueryCreatedBy", fields: [created_by_user_id], references: [id])
  resolved_by_user User?    @relation("QueryResolvedBy", fields: [resolved_by_user_id], references: [id])
  replies        QueryReply[]
  internal_notes QueryInternalNote[]
  attachments    QueryAttachment[]
  audit_logs     QueryAuditLog[]

  @@index([student_id])
  @@index([status])
  @@index([query_type])
  @@index([created_by_user_id])
  @@map("student_queries")
}

// ──────────────────────────────────────────────
// Video Lectures (YouTube videos uploaded via Excel)
// ──────────────────────────────────────────────

model VideoLecture {
  id             String             @id @default(uuid())
  date           String                  // e.g. "2026-04-10"
  time           String                  // e.g. "17:00"
  class_id       String
  subject_id     String
  video_url      String                  // YouTube URL
  title          String?                 // Optional title
  status         String             @default("active")  // active | inactive
  uploaded_by    String?                 // User ID who uploaded
  sheet_row_id   String?            @unique             // Google Sheet Row ID/Hash
  teacher_name   String?
  description    String?
  topic          String?
  chapter        String?
  notes          String?
  sync_source_id String?
  created_at     DateTime           @default(now())
  updated_at     DateTime           @updatedAt

  // Relations
  class_ref      Class              @relation(fields: [class_id], references: [id], onDelete: Cascade)
  subject        Subject            @relation(fields: [subject_id], references: [id], onDelete: Cascade)
  sync_source    GoogleSheetSource? @relation(fields: [sync_source_id], references: [id], onDelete: SetNull)

  @@unique([date, time, class_id, subject_id])
  @@index([class_id, date])
  @@index([date])
  @@index([subject_id])
  @@map("video_lectures")
}

// ──────────────────────────────────────────────
// Study Materials (PDF Documents directly uploaded to Cloudinary)
// ──────────────────────────────────────────────

model StudyMaterial {
  id          String   @id @default(uuid())
  title       String
  subject_id  String
  class_id    String
  pdf_url     String
  uploaded_by String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  status      String   @default("active")  // active, hidden

  // Relations
  class_ref   Class    @relation(fields: [class_id], references: [id], onDelete: Cascade)
  uploader    User     @relation("UploaderMaterial", fields: [uploaded_by], references: [id])
  subject     Subject  @relation(fields: [subject_id], references: [id], onDelete: Cascade)

  @@index([class_id])
  @@index([subject_id])
  @@index([uploaded_by])
  @@map("study_materials")
}

// ──────────────────────────────────────────────
// Notifications
// ──────────────────────────────────────────────

model Notification {
  id           String   @id @default(uuid())
  recipient_id String
  sender_id    String?
  type         String                  // test_scheduled, marks_uploaded, announcement, general
  title        String
  message      String
  reference_id String?                 // ID of related entity (test, etc.)
  is_read      Boolean  @default(false)
  created_at   DateTime @default(now())

  // Relations
  recipient    User     @relation("NotificationRecipient", fields: [recipient_id], references: [id], onDelete: Cascade)
  sender       User?    @relation("NotificationSender", fields: [sender_id], references: [id])

  @@index([recipient_id, is_read])
  @@index([recipient_id, created_at])
  @@index([type])
  @@map("notifications")
}

// ──────────────────────────────────────────────
// global settings
// ──────────────────────────────────────────────

model SystemSetting {
  id                       String   @id @default("global")
  institution_name         String   @default("Proton Coaching")
  contact_email            String   @default("admin@protoncoaching.com")
  phone_number             String   @default("+91-0000000000")
  currency                 String   @default("INR")
  address                  String?

  allow_student_registration Boolean  @default(true)
  require_email_verification Boolean  @default(false)
  enable_2fa                 Boolean  @default(false)
  
  email_notifications        Boolean  @default(true)
  sms_notifications          Boolean  @default(true)

  // Google Sheets Auto-Sync Settings
  google_sheets_enabled      Boolean  @default(false)
  google_spreadsheet_id      String?
  google_sheet_name          String   @default("Videos")
  google_sync_interval_minutes Int    @default(5)

  updated_at                 DateTime @updatedAt

  @@map("system_settings")
}

// ──────────────────────────────────────────────
// Teacher Activity Logs & Remarks
// ──────────────────────────────────────────────

model StudentRemark {
  id          String   @id @default(uuid())
  student_id  String
  teacher_id  String
  remark      String   @db.Text
  remark_type String   @default("general") // general, performance, improvement
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacher_id], references: [id], onDelete: Cascade)

  @@index([student_id])
  @@index([teacher_id])
  @@map("student_remarks")
}

model TeacherActivityLog {
  id              String   @id @default(uuid())
  teacher_id      String?
  teacher_name    String
  action_type     String   // e.g., "schedule_create", "schedule_update", "schedule_delete", "attendance_mark", "marks_upload", "remarks_add", "login"
  previous_value  String?  @db.Text
  new_value       String?  @db.Text
  affected_entity String?  // e.g., "Class 12 Physics", "Student Rahul (PRO-102)"
  ip_address      String?
  device          String?
  created_at      DateTime @default(now())

  teacher         Teacher? @relation(fields: [teacher_id], references: [id], onDelete: SetNull)

  @@index([teacher_id])
  @@index([action_type])
  @@index([created_at])
  @@map("teacher_activity_logs")
}

// ──────────────────────────────────────────────
// Chat Messages
// ──────────────────────────────────────────────

model Message {
  id           String   @id @default(uuid())
  sender_id    String
  recipient_id String
  content      String   @db.Text
  is_read      Boolean  @default(false)
  created_at   DateTime @default(now())

  sender    User @relation("SentMessages", fields: [sender_id], references: [id], onDelete: Cascade)
  recipient User @relation("ReceivedMessages", fields: [recipient_id], references: [id], onDelete: Cascade)

  @@index([sender_id])
  @@index([recipient_id])
  @@index([created_at])
  @@map("messages")
}

// ──────────────────────────────────────────────
// Enquiry Management Additions
// ──────────────────────────────────────────────

model QueryReply {
  id         String       @id @default(uuid())
  query_id   String
  user_id    String
  message    String       @db.Text
  created_at DateTime     @default(now())

  query      StudentQuery @relation(fields: [query_id], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([query_id])
  @@map("query_replies")
}

model QueryInternalNote {
  id         String       @id @default(uuid())
  query_id   String
  user_id    String
  note       String       @db.Text
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt

  query      StudentQuery @relation(fields: [query_id], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([query_id])
  @@map("query_internal_notes")
}

model QueryAttachment {
  id         String       @id @default(uuid())
  query_id   String
  file_name  String
  file_url   String
  file_size  Int?
  created_at DateTime     @default(now())

  query      StudentQuery @relation(fields: [query_id], references: [id], onDelete: Cascade)

  @@index([query_id])
  @@map("query_attachments")
}

model QueryAuditLog {
  id         String       @id @default(uuid())
  query_id   String
  user_id    String
  action     String
  details    String       @db.Text
  created_at DateTime     @default(now())

  query      StudentQuery @relation(fields: [query_id], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([query_id])
  @@map("query_audit_logs")
}

// ──────────────────────────────────────────────
// Coordinator
// ──────────────────────────────────────────────

model Coordinator {
  id             String   @id @default(uuid())
  user_id        String   @unique
  coordinator_id String?  @unique // e.g. COORD2026001
  full_name      String?
  email          String?
  phone          String?
  gender         String?
  profile_image  String?
  status         String   @default("active")
  created_by     String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  user           User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("coordinators")
}

// ──────────────────────────────────────────────
// Email Logs for operational tracking
// ──────────────────────────────────────────────

model EmailLog {
  id             String   @id @default(uuid())
  recipient      String
  mail_type      String
  status         String   // sent | failed
  sent_at        DateTime @default(now())
  failure_reason String?  @db.Text

  @@map("email_logs")
}

// ──────────────────────────────────────────────
// Subjects Master Data
// ──────────────────────────────────────────────

model Subject {
  id             String         @id @default(uuid())
  canonical_name String         @unique
  normalized_key String         @unique
  short_name     String?
  code           String?
  description    String?
  is_active      Boolean        @default(true)
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt
  aliases        SubjectAlias[]

  // Reverse Relations
  class_subjects              ClassSubject[]
  class_schedules             ClassSchedule[]
  student_subject_enrollments StudentSubjectEnrollment[]
  timetable_entries           Timetable[]
  demo_classes                DemoClass[]
  attendance_records          Attendance[]
  tests                       Test[]
  homeworks                   Homework[]
  video_lectures              VideoLecture[]
  study_materials             StudyMaterial[]

  @@map("subjects")
}

model ClassSubject {
  class_id   String
  subject_id String
  
  class      Class   @relation(fields: [class_id], references: [id], onDelete: Cascade)
  subject    Subject @relation(fields: [subject_id], references: [id], onDelete: Cascade)

  @@id([class_id, subject_id])
  @@map("class_subjects")
}

model SubjectAlias {
  id             String   @id @default(uuid())
  subject_id     String
  alias          String   @unique
  normalized_key String   @unique
  subject        Subject  @relation(fields: [subject_id], references: [id], onDelete: Cascade)

  @@map("subject_aliases")
}

model GoogleSheetSyncLog {
  id             String             @id @default(uuid())
  sync_type      String             @default("video_lectures")
  source_id      String?
  user_id        String?
  start_time     DateTime           @default(now())
  end_time       DateTime?
  rows_processed Int                @default(0)
  rows_created   Int                @default(0)
  rows_updated   Int                @default(0)
  rows_deleted   Int                @default(0)
  rows_failed    Int                @default(0)
  status         String             // "success" | "failed"
  error_message  String?            @db.Text

  source         GoogleSheetSource? @relation(fields: [source_id], references: [id], onDelete: Cascade)
  user           User?              @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@map("google_sheet_sync_logs")
}

model GoogleSheetSource {
  id               String               @id @default(uuid())
  name             String
  spreadsheet_id   String
  sheet_name       String               @default("Videos")
  column_mapping   Json                 // Stores column mappings e.g. { "class": "Class", "subject": "Subject", ... }
  is_enabled       Boolean              @default(true)
  last_sync        DateTime?
  last_sync_status String?              // "success" | "failed"
  created_at       DateTime             @default(now())
  updated_at       DateTime             @updatedAt
  
  sync_logs        GoogleSheetSyncLog[]
  video_lectures   VideoLecture[]

  @@map("google_sheet_sources")
}


