{
  "version": 2,
  "regions": ["sin1"],
  "builds": [
    {
      "src": "src/app.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "prisma/schema.prisma",
          "node_modules/.prisma/client/**"
        ]
      }
    }
  ],
  "crons": [
    {
      "path": "/api/whatsapp/test/fee-reminder",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/whatsapp/test/timetable",
      "schedule": "0 7 * * 1"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/app.ts"
    }
  ]
}
